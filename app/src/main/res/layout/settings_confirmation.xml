<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout style="@style/ShelfDrive.Settings.Page">

        <TextView
            android:id="@+id/settings_confirm_title"
            style="@style/ShelfDrive.Settings.Title"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/settings_confirm_message"
            style="@style/ShelfDrive.Settings.Body"
            android:layout_marginTop="14dp" />

        <LinearLayout
            style="@style/ShelfDrive.Settings.Actions"
            android:gravity="end|top"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_confirm_cancel"
                style="@style/ShelfDrive.Settings.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@android:string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_confirm_action"
                style="@style/ShelfDrive.Settings.Button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
